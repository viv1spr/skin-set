ion\\\":\\\"Продать скины CS 2 за реальные деньги быстро и безопасно на Avan Market. Моментальная продажа предметов с выводом денег на карту!\\\",\\\"aggregateRating\\\":{\\\"@type\\\":\\\"AggregateRating\\\",\\\"ratingValue\\\":\\\"5\\\",\\\"worstRating\\\":\\\"1\\\",\\\"bestRating\\\":\\\"5\\\",\\\"ratingCount\\\":\\\"20807\\\"}}\"}}],\"$L1c\",[\"$\",\"$L1d\",null,{\"initialAlerts\":[{\"id\":50,\"message\":\"Уважаемые пользователи! Сейчас наблюдаются технические сложности при покупке предметов. \\nНаши специалисты уже занимаются решением проблемы. Приносим извинения за доставленные неудобства.\",\"messageEn\":\"Dear Users! We are currently experiencing technical difficulties with purchasing items.\\nOur specialists are already working to resolve the issue. We apologize for the inconvenience.\",\"endDate\":\"2045-07-09T21:00:00.000Z\",\"pages\":[\"/\",\"/market/cs\",\"/market/dota2\",\"/market/tf2\",\"/market/rust\"]}],\"locale\":\"ru\"}],[\"$\",\"div\",null,{\"className\":\"page-module__F5eaRq__marketPage\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"page-module__F5eaRq__h1\",\"children\":\"Купить скины КС 2\"}],[\"$\",\"$13\",null,{\"fallback\":[\"$\",\"div\",null,{\"className\":\"MainPageLoader-module__QvmoIW__loaderContainer\",\"children\":[\"$\",\"div\",null,{\"className\":\"MainPageLoader-module__QvmoIW__loader\",\"children\":[\"$\",\"$L1e\",null,{}]}]}],\"children\":[null,null,[\"$\",\"$L1f\",null,{\"locale\":\"ru\",\"game\":\"cs\",\"SSRMarketData\":null}]]}],null]}],[\"$\",\"$13\",null,{\"fallback\":null,\"children\":\"$L20\"}],\"$L21\"]\n"])</script><script>self.__next_f.push([1,"24:[\"$\",\"img\",null,{\"src\":\"//counter.rambler.ru/top100.cnt?pid=7726955\",\"alt\":\"Топ-100\"}]\n25:[\"$\",\"div\",null,{\"children\":[\"$\",\"img\",null,{\"src\":\"https://top-fwz1.mail.ru/counter?id=3703223;js=na\",\"style\":{\"position\":\"absolute\",\"left\":\"-9999px\"},\"alt\":\"Top.Mail.Ru\"}]}]\n26:[\"$\",\"img\",null,{\"height\":\"1\",\"width\":\"1\",\"alt\":\